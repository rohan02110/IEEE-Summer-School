# From Supabase: Project Settings -> Database -> Connection string -> URI
# Use the "Transaction pooler" (port 6543) if hosting on a serverless/ephemeral
# platform; use the direct connection (port 5432) for a long-running server/laptop.
SUPABASE_DB_URL=postgresql://postgres.xxxxx:[email protected]:6543/postgres

SECRET_KEY=replace-with-long-random-string
VOLUNTEER_PIN=4821
ADMIN_PIN=917304
EVENT_DATES=2026-10-12,2026-10-13,2026-10-14,2026-10-15,2026-10-16
